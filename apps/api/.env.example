NODE_ENV=development
PORT=4200

# The web app's origin (allowed to call this API with cookies).
WEB_ORIGIN=http://localhost:3300

# Local dev DB: run `npm run db:mem -w @numvexs/api` in another terminal.
MONGODB_URI=mongodb://localhost:27019/numvexs?replicaSet=rs0&directConnection=true

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-please

# false on http://localhost, true in production (https).
# How many proxies are in front of the API: 1 for Nginx on a VPS or Render alone, 2 when Vercel proxies to Render.
TRUST_PROXY=1
COOKIE_SECURE=false

# Email goes out over SMTP from the business's own mailbox (Namecheap Private Email: host mail.privateemail.com, port 465, the
# full mailbox address as user). Leave SMTP_HOST empty in dev: codes are printed in this terminal instead of emailed.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The sender shown to users. Must be the mailbox above (or one it is allowed to send as).
EMAIL_FROM=NumVex <no-reply@yourdomain.com>

# Virtual-number servers. A server with no key shows "not set up yet" on its tab.
DAISYSMS_API_KEY=
TEXTVERIFIED_API_KEY=
TEXTVERIFIED_USERNAME=
SMSPOOL_API_KEY=
HEROSMS_API_KEY=
SMSBOWER_API_KEY=
MANESMS_API_KEY=
# 5sim's catalogue is public, but buying needs the key from your 5sim profile (a long JWT). SMSBOWER_BASE_URL is optional.
FIVESIM_API_KEY=
JUICYSMS_API_KEY=

# Number pricing: provider dollar price x USD_NGN_RATE, plus NUMBER_MARKUP_PERCENT, rounded up to a whole naira.
USD_NGN_RATE=1500
# JuicySMS prices are in euros: 1 EUR in USD (applied before USD_NGN_RATE).
EUR_USD_RATE=1.15
NUMBER_MARKUP_PERCENT=30

# Boosting (SMM panels, all on the standard /api/v2). A server with no key shows "not set up yet" on its tab.
MORETHANPANEL_API_KEY=
PEAKERR_API_KEY=
RESELLERSMM_API_KEY=
# Boost price per 1,000 = panel dollar rate x USD_NGN_RATE, plus this percentage.
BOOST_MARKUP_PERCENT=30

# Bank-transfer funding: one static bank account per user (PocketFi, docs: developer.pocketfi.ng/docs).
# POCKETFI_MODE=test uses their sandbox (no real money). Use live only when you mean it.
POCKETFI_MODE=test
POCKETFI_API_TOKEN=
POCKETFI_BUSINESS_ID=
# From PocketFi dashboard -> Settings -> Webhooks. Webhook URL to register: https://<your-api-domain>/api/v1/webhooks/pocketfi
POCKETFI_WEBHOOK_SECRET=
POCKETFI_BANK=paga

# Telegram Premium and Stars. sk_test_... is a sandbox key (delivers instantly, never charges); sk_live_... spends real money.
GRAMSUBS_SECRET_KEY=
# Telegram price = the supplier's dollar price x USD_NGN_RATE, plus this percentage.
TELEGRAM_MARKUP_PERCENT=30

# eSIMs use SMSPOOL_API_KEY. eSIM price = the provider's dollar price x USD_NGN_RATE, plus this percentage.
ESIM_MARKUP_PERCENT=30
# Number rentals use TEXTVERIFIED_* and JUICYSMS_API_KEY. Rental price = the provider's dollar price x USD_NGN_RATE, plus this percentage.
RENTAL_MARKUP_PERCENT=30
